# Maintainer: Zaid Qamhieh
# Repackages the official agent release (agent + sidecars + manifest) for Arch. The agent refuses sidecars that do
# not match rfe-sidecars.txt, so all four files are installed together into /usr/bin.
# After the version or checksums change: updpkgsums, then makepkg --printsrcinfo > .SRCINFO.
pkgname=rfe-bin
pkgver=1.0.0
pkgrel=1
pkgdesc='RFE host agent with its Rust sidecars (binary release)'
arch=('x86_64' 'aarch64')
url='https://github.com/ZaidQamhieh/rfe'
license=('GPL-3.0-only')
depends=('glibc')
optdepends=('libcap: setcap lets the agent also listen on port 443 (done by the install hook)')
provides=('rfe')
conflicts=('rfe' 'rfe-agent' 'rfe-agent-bin')
replaces=('rfe-agent-bin')
options=('!strip')
install=rfe-bin.install
_rel="$url/releases/download/agent-v$pkgver"
source_x86_64=("agent-v$pkgver-linux-amd64.tar.gz::$_rel/agent-v$pkgver-linux-amd64.tar.gz")
source_aarch64=("agent-v$pkgver-linux-arm64.tar.gz::$_rel/agent-v$pkgver-linux-arm64.tar.gz")
source=('rfe.service')
sha256sums=('SKIP')
sha256sums_x86_64=('aa209792054db7e80ab64273e12eedd323ff9de09a93a30fe9184b36da8f1b80')
sha256sums_aarch64=('6442ded700423368cd025435183ba563ac755d69c6c182e678b5f2b142c85270')

package() {
  install -Dm755 rfe rfe-indexd rfe-thumbd -t "$pkgdir/usr/bin"
  install -Dm644 rfe-sidecars.txt -t "$pkgdir/usr/bin"
  install -Dm644 rfe.service "$pkgdir/usr/lib/systemd/user/rfe.service"
}
