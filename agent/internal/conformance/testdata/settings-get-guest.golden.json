{
  "status": 200,
  "headers": {
    "Cache-Control": "no-store",
    "Content-Type": "application/json",
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff"
  },
  "json": {
    "accessDenied": false,
    "agentName": "conformance-agent",
    "allowSharing": true,
    "effectiveScope": "device",
    "fileCapabilities": {
      "browse": true,
      "delete": false,
      "download": false,
      "modify": false,
      "share": false,
      "upload": false,
      "wake": false
    },
    "isAdmin": false,
    "photoBackupAvailable": false,
    "photoBackupConfigured": false,
    "readOnly": false,
    "roots": [
      "<ROOT>"
    ]
  }
}
