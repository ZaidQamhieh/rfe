{
  "status": 201,
  "headers": {
    "Cache-Control": "no-store",
    "Content-Type": "application/json",
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff"
  },
  "json": {
    "created": "<created>",
    "isDir": true,
    "isSymlink": false,
    "mode": "drwxr-xr-x",
    "modified": "<modified>",
    "name": "made",
    "path": "<ROOT>/made",
    "size": "<dirSize>"
  }
}
