{
  "status": 200,
  "headers": {
    "Cache-Control": "no-store",
    "Content-Type": "application/json",
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff"
  },
  "json": {
    "expiresAt": "<expiresAt>",
    "token": "<token>",
    "tokenHash": "<tokenHash>",
    "url": "<url>"
  }
}
