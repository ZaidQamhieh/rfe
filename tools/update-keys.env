# Public halves of the host-update signing keys (private halves: ~/.rfe-keystore/update-signing/, never in the repo).
# package-agent.sh bakes them into the agent. Rotate by signing with the spare and replacing the primary here.
# RFE_UPDATE_MANIFEST_URL is where the signed manifest is published (tools/publish-manifest.sh uploads it there after
# each host release); an unset value makes "rfe update check" refuse to run.
RFE_UPDATE_MANIFEST_URL=https://github.com/ZaidQamhieh/rfe/releases/download/host-manifest/manifest.json
RFE_UPDATE_PRIMARY_PUBKEY=VGaLIUwfQlzLonIcGAf9OTTsJiJWMo7FqqL4WfsUz6A=
RFE_UPDATE_SPARE_PUBKEY=PEXSQSZnA1SXgBAjCVSAaII3AsfH2g/HA/3NjPfd/OU=
