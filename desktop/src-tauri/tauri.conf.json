{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RFE Desktop",
  "version": "1.0.1",
  "identifier": "app.rfe.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RFE Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Control your PC from your PC: pin the RFE agent and manage its devices",
    "longDescription": "RFE Desktop connects to an rfe after you compare its certificate fingerprint, signs in with your account, and lists the devices paired with it. Secrets are kept in the OS keystore (Secret Service on Linux).",
    "publisher": "RFE",
    "linux": {
      "deb": {
        "depends": [
          "libdbus-1-3"
        ],
        "recommends": [
          "gnome-keyring | keepassxc",
          "libayatana-appindicator3-1"
        ],
        "desktopTemplate": "packaging/linux/rfe-desktop.desktop",
        "files": {
          "/usr/share/metainfo/app.rfe.desktop.metainfo.xml": "packaging/linux/app.rfe.desktop.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "dbus-libs"
        ],
        "recommends": [
          "gnome-keyring"
        ],
        "desktopTemplate": "packaging/linux/rfe-desktop.desktop",
        "files": {
          "/usr/share/metainfo/app.rfe.desktop.metainfo.xml": "packaging/linux/app.rfe.desktop.metainfo.xml"
        }
      }
    }
  }
}
